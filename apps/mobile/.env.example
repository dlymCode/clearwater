# Copy to .env (never commit .env). EXPO_PUBLIC_* values are bundled into the app: anon key only,
# NEVER the Supabase service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Worker (workers/tile-auth) that exchanges a Supabase JWT for a signed R2 URL.
TILE_AUTH_URL=https://tiles.example.com/sign
# Base URL of the (private) R2 bucket's tiles/index.json, behind the worker.
EXPO_PUBLIC_TILES_INDEX_URL=https://tiles.example.com/tiles/index.json
# Optional
EXPO_PUBLIC_SENTRY_DSN=
