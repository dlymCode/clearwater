# Copy to supabase/.env (never commit it) for `supabase functions serve --env-file supabase/.env`,
# and set the same names as secrets on the hosted project: `supabase secrets set --env-file supabase/.env`.
# Placeholder names only.

# Injected automatically on hosted Supabase; set them yourself for local `functions serve`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# >= 32 random characters (e.g. `openssl rand -hex 32`). Keys the daily uploader-hash salt.
HMAC_SALT_SECRET=

# Comma-separated auth.users ids allowed to call the `admin` function.
ADMIN_UIDS=

# Sign in with Apple (read by config.toml via env()).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Cloudflare R2 credentials are used by the pipeline runner and the tile-auth Worker, not by
# these functions. Listed here so one file documents every name in the system:
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
